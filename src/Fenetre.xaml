        </Expander>
        <TextBlock x:Name="BoxMessage" Grid.Row="2" TextWrapping="Wrap" Margin="0,12,0,5"/>
        <DataGrid x:Name="BoxPreview" Grid.Row="3" AutomationProperties.Name="Aperçu des clients de la box"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" RowHeight="29"/>
        <WrapPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,12,0,0">
          <Button x:Name="CancelBoxImport" Style="{StaticResource Action}" IsCancel="True" Content="Annuler" Margin="0,0,8,0"/>
          <Button x:Name="AcceptBoxImport" Style="{StaticResource PrimaryAction}" Content="Importer la liste" IsEnabled="False"/>
        </WrapPanel>
      </Grid>
    </DataTemplate>
  </Window.Resources>
