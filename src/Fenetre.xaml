<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Toolbox" Width="1150" Height="795" MinWidth="415" MinHeight="390"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource CanvasBrush}" FontFamily="Segoe UI"
        Foreground="{DynamicResource TextBrush}" FontSize="14" Language="fr-FR" UseLayoutRounding="True">
  <Window.Resources>
    <SolidColorBrush x:Key="CanvasBrush" Color="#F5F6FA"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1A2438"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#526078"/>
    <SolidColorBrush x:Key="LineBrush" Color="#D7DDEA"/>
    <SolidColorBrush x:Key="FieldLineBrush" Color="#8996AF"/>
    <SolidColorBrush x:Key="InkBrush" Color="#172139"/>
    <SolidColorBrush x:Key="InkMutedBrush" Color="#D7E0F4"/>
    <SolidColorBrush x:Key="InkHoverBrush" Color="#293958"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#3656D4"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2946BD"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#203995"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EEF2FF"/>
    <SolidColorBrush x:Key="AccentLineBrush" Color="#B8C6F4"/>
    <SolidColorBrush x:Key="DisabledFillBrush" Color="#E8EBF1"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#5C687C"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#24624E"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#EAF6F0"/>
    <SolidColorBrush x:Key="SuccessLineBrush" Color="#AFD6C1"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#835113"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF3DC"/>
    <SolidColorBrush x:Key="WarningLineBrush" Color="#E3C595"/>
    <Style x:Key="FocusRing" TargetType="Control">
      <Setter Property="Template"><Setter.Value><ControlTemplate>
        <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" CornerRadius="8" Margin="-2" IsHitTestVisible="False">
          <Border BorderBrush="{StaticResource SurfaceBrush}" BorderThickness="1" CornerRadius="6"/>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button" x:Key="Action">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,8"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Grid>
          <Border x:Name="Frame" CornerRadius="7" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
          <Border x:Name="Interaction" CornerRadius="7" IsHitTestVisible="False"/>
          <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True">
            <Setter TargetName="Interaction" Property="Background" Value="#123F67D4"/>
            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource FieldLineBrush}"/>
          </Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Interaction" Property="Background" Value="#293F67D4"/></Trigger>
          <Trigger Property="IsEnabled" Value="False">
            <Setter TargetName="Frame" Property="Background" Value="{StaticResource DisabledFillBrush}"/>
            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter TargetName="Interaction" Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
          </Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style x:Key="PrimaryAction" TargetType="Button" BasedOn="{StaticResource Action}">
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/><Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource SurfaceBrush}"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/></Trigger>
        <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{StaticResource AccentPressedBrush}"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource Action}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource InkMutedBrush}"/>
      <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Padding" Value="11,8"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,1"/>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource InkHoverBrush}"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="Glyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="17"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="CornerRadius" Value="12"/><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="20,18"/>
    </Style>
    <Style x:Key="ConverterPane" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Padding" Value="18"/><Setter Property="CornerRadius" Value="14"/>
    </Style>
    <Style x:Key="ConverterHeading" TargetType="TextBlock">
      <Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,0,0,15"/>
    </Style>
    <Style x:Key="ConverterLabel" TargetType="Label">
      <Setter Property="Padding" Value="0,0,0,5"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    </Style>
    <Style x:Key="ConverterDrop" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource MediaTint}"/><Setter Property="CornerRadius" Value="10"/>
      <Setter Property="AllowDrop" Value="True"/>
      <Style.Triggers><Trigger Property="Tag" Value="Drag"><Setter Property="Background" Value="{DynamicResource MediaHighlight}"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="ConverterOutline" TargetType="Rectangle">
      <Setter Property="Stroke" Value="{DynamicResource MediaOutline}"/><Setter Property="StrokeThickness" Value="1"/>
      <Setter Property="RadiusX" Value="10"/><Setter Property="RadiusY" Value="10"/><Setter Property="StrokeDashArray" Value="4,4"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
      <Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=Border}}" Value="Drag">
        <Setter Property="Stroke" Value="{DynamicResource MediaInk}"/><Setter Property="StrokeThickness" Value="2"/>
      </DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="ConverterArtArea" TargetType="Grid">
      <Setter Property="Height" Value="103"/>
      <Style.Triggers><Trigger Property="Tag" Value="Compact"><Setter Property="Height" Value="62"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="ConverterArtwork" TargetType="ContentControl">
      <Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="IsHitTestVisible" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContentControl">
        <Viewbox Stretch="Uniform">
          <Canvas Width="166" Height="100">
            <Ellipse Width="94" Height="8" Canvas.Left="34" Canvas.Top="89" Fill="{DynamicResource MediaInk}" Opacity=".09"/>
            <Path Data="M22,24 H30 M26,20 V28 M141,62 H148 M145,58 V65" Stroke="{DynamicResource MediaInk}" Opacity=".45" StrokeThickness="1.3"/>
            <Rectangle Canvas.Left="42" Canvas.Top="13" Width="87" Height="69" RadiusX="7" RadiusY="7" Fill="{DynamicResource MediaHighlight}"
                       Stroke="{DynamicResource MediaOutline}" RenderTransformOrigin=".5,.5">
              <Rectangle.RenderTransform><RotateTransform Angle="11"/></Rectangle.RenderTransform>
            </Rectangle>
            <Rectangle Canvas.Left="30" Canvas.Top="18" Width="94" Height="66" RadiusX="7" RadiusY="7" Fill="White"
                       Stroke="{DynamicResource MediaOutline}" RenderTransformOrigin=".5,.5">
              <Rectangle.RenderTransform><RotateTransform Angle="-9"/></Rectangle.RenderTransform>
            </Rectangle>
            <Border Canvas.Left="38" Canvas.Top="18" Width="93" Height="64" Background="White" CornerRadius="7"
                    BorderBrush="{DynamicResource MediaInk}" BorderThickness="1.3">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Path Data="M8,7 H10 M14,7 H16 M20,7 H22" Stroke="{DynamicResource MediaOutline}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                <Border Grid.Row="1" Margin="5,0,5,5" CornerRadius="3" Background="{DynamicResource MediaInk}">
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
              </Grid>
            </Border>
            <Ellipse Width="4" Height="4" Canvas.Left="138" Canvas.Top="22" Fill="{DynamicResource MediaInk}" Opacity=".55"/>
          </Canvas>
        </Viewbox>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ConverterMessage" TargetType="TextBlock">
      <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="0,8,0,0"/><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="ConversionResult" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/><Setter Property="BorderBrush" Value="{StaticResource WarningLineBrush}"/>
      <Setter Property="TextElement.Foreground" Value="{StaticResource WarningBrush}"/>
      <Style.Triggers><Trigger Property="Tag" Value="Complet">
        <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/><Setter Property="BorderBrush" Value="{StaticResource SuccessLineBrush}"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource SuccessBrush}"/>
      </Trigger></Style.Triggers>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource FieldLineBrush}"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="9,6"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="InputFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
          <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="InputFrame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputFrame" Property="Background" Value="{StaticResource DisabledFillBrush}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#7C88A0"/>
    <Style x:Key="ScrollPageArea" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="13"/><Setter Property="Cursor" Value="Arrow"/>
      <Setter Property="Foreground" Value="{DynamicResource ScrollThumbBrush}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Grid Background="Transparent">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
            <Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Style="{StaticResource ScrollPageArea}" Command="{x:Static ScrollBar.PageUpCommand}"/></Track.DecreaseRepeatButton>
            <Track.Thumb>
              <Thumb x:Name="Handle" Focusable="False" MinHeight="18" Tag="{TemplateBinding Orientation}" Background="{TemplateBinding Foreground}">
                <Thumb.Template><ControlTemplate TargetType="Thumb">
                  <Grid Background="Transparent">
                    <Border x:Name="VerticalGrip" Width="3" Margin="0,2" CornerRadius="3" Background="{TemplateBinding Background}"/>
                    <Border x:Name="HorizontalGrip" Height="3" Margin="2,0" CornerRadius="3" Background="{TemplateBinding Background}" Visibility="Collapsed"/>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="Tag" Value="{x:Static Orientation.Horizontal}">
                      <Setter TargetName="VerticalGrip" Property="Visibility" Value="Collapsed"/>
                      <Setter TargetName="HorizontalGrip" Property="Visibility" Value="Visible"/>
                    </Trigger>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
                      <Setter TargetName="VerticalGrip" Property="Width" Value="5"/><Setter TargetName="HorizontalGrip" Property="Height" Value="5"/>
                    </DataTrigger>
                    <Trigger Property="IsDragging" Value="True">
                      <Setter TargetName="VerticalGrip" Property="Width" Value="5"/><Setter TargetName="HorizontalGrip" Property="Height" Value="5"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate></Thumb.Template>
              </Thumb>
            </Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Style="{StaticResource ScrollPageArea}" Command="{x:Static ScrollBar.PageDownCommand}"/></Track.IncreaseRepeatButton>
          </Track>
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="Orientation" Value="Horizontal">
            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
            <Setter TargetName="Decrease" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
            <Setter TargetName="Increase" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
            <Setter TargetName="Handle" Property="MinHeight" Value="0"/><Setter TargetName="Handle" Property="MinWidth" Value="18"/>
          </Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Handle" Property="Opacity" Value=".5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="13"/>
      </Trigger></Style.Triggers>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource FieldLineBrush}"/><Setter Property="MinHeight" Value="40"/>
      <Setter Property="MaxDropDownHeight" Value="335"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="9,6"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Style.Triggers>
        <Trigger Property="IsEditable" Value="False"><Setter Property="Template"><Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="37"/></Grid.ColumnDefinitions>
              <Border x:Name="Field" Grid.ColumnSpan="2" Background="{TemplateBinding Background}" CornerRadius="8"
                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
              <Border Padding="{TemplateBinding Padding}" Margin="2,0,0,0" ClipToBounds="True">
                <ContentPresenter IsHitTestVisible="False"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}">
                  <ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></ContentPresenter.Resources>
                </ContentPresenter>
              </Border>
              <Border x:Name="Indicator" Grid.Column="1" Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center"
                      Margin="3,0,0,0" CornerRadius="6" Background="{StaticResource CanvasBrush}" IsHitTestVisible="False">
                <Path x:Name="Arrow" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 1,1 L 5.5,5.5 L 10,1"
                      Stroke="{StaticResource MutedBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Border>
              <ToggleButton Grid.ColumnSpan="2" Focusable="False" ClickMode="Press" Cursor="Hand"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup" Placement="Bottom" HorizontalOffset="-7" Focusable="False" AllowsTransparency="True"
                     PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}" IsOpen="{TemplateBinding IsDropDownOpen}">
                <Grid Margin="7,5,7,9" MinWidth="{TemplateBinding ActualWidth}" MaxWidth="475" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                  <Border Background="{StaticResource SurfaceBrush}" CornerRadius="10" IsHitTestVisible="False">
                    <Border.Effect><DropShadowEffect Color="#172139" ShadowDepth="2" BlurRadius="8" Opacity=".20"/></Border.Effect>
                  </Border>
                  <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource AccentLineBrush}" BorderThickness="1" CornerRadius="10" Padding="5">
                    <ScrollViewer x:Name="Options" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained"/>
                    </ScrollViewer>
                  </Border>
                </Grid>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
              <Trigger Property="IsDropDownOpen" Value="True">
                <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                <Setter TargetName="Indicator" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                <Setter TargetName="Arrow" Property="Data" Value="M 1,5.5 L 5.5,1 L 10,5.5"/>
                <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Field" Property="Background" Value="{StaticResource DisabledFillBrush}"/>
                <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value></Setter></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="0,1"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
        <Border x:Name="Item" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
            <ContentPresenter ContentSource="Content" VerticalAlignment="Center">
              <ContentPresenter.Resources><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style></ContentPresenter.Resources>
            </ContentPresenter>
            <Path x:Name="SelectedMark" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Hidden"
                  Data="M 1,6 L 4.5,9.5 L 12,2" Stroke="{StaticResource AccentBrush}" StrokeThickness="1.9" StrokeLineJoin="Round"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsHighlighted" Value="True">
            <Setter TargetName="Item" Property="Background" Value="{StaticResource CanvasBrush}"/>
            <Setter TargetName="Item" Property="BorderBrush" Value="{StaticResource LineBrush}"/>
          </Trigger>
          <Trigger Property="IsSelected" Value="True">
            <Setter TargetName="Item" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            <Setter TargetName="SelectedMark" Property="Visibility" Value="Visible"/>
            <Setter Property="Foreground" Value="{StaticResource AccentPressedBrush}"/>
          </Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Item" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Label"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="Padding" Value="3"/>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="{Binding HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}"/><Setter Property="AlternatingRowBackground" Value="{StaticResource CanvasBrush}"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="{StaticResource CanvasBrush}"/><Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="7,5"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/><Setter Property="BorderThickness" Value="0,0,1,1"/>
    </Style>
    <Style x:Key="BatchList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
      <Setter Property="MaxHeight" Value="440"/><Setter Property="Margin" Value="0,12,0,0"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
      <Setter Property="AutomationProperties.Name" Value="Suivi des fichiers"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
        <Border Style="{StaticResource ConverterPane}" Padding="16,13">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,8">
              <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource MutedBrush}"
                         Text="{Binding Items.Count, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0} fichiers}"/>
              <TextBlock Text="Suivi des fichiers" FontSize="18" FontWeight="SemiBold"/>
            </DockPanel>
            <ScrollViewer x:Name="PART_ScrollViewer" Grid.Row="1" Focusable="False" CanContentScroll="True"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ItemsPresenter/>
            </ScrollViewer>
          </Grid>
        </Border>
      </ControlTemplate></Setter.Value></Setter>
      <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
        <Setter Property="AutomationProperties.ItemStatus" Value="{Binding Status}"/>
        <Setter Property="AutomationProperties.HelpText" Value="{Binding Details}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Row" Background="Transparent" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="4,10,4,9">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource CanvasBrush}"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSoftBrush}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
      </Style></Setter.Value></Setter>
      <Setter Property="ItemTemplate"><Setter.Value><DataTemplate>
        <Grid ToolTip="{Binding Source}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Grid.RowSpan="2" Width="44" Height="34" Margin="0,1,10,0" VerticalAlignment="Top" CornerRadius="7"
                  Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
            <TextBlock Text="{Binding FileType}" TextAlignment="Center" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                       Margin="2,0" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
          </Border>
          <TextBlock Grid.Column="1" Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <Border x:Name="StateBadge" Grid.Column="2" Background="{StaticResource CanvasBrush}" Padding="7,3" CornerRadius="5"
                  MaxWidth="133" HorizontalAlignment="Right" VerticalAlignment="Top">
            <DockPanel>
              <TextBlock x:Name="StateGlyph" Text="&#xE823;" Style="{StaticResource Glyph}" FontSize="12" Margin="0,0,4,0" Foreground="{StaticResource MutedBrush}"/>
              <TextBlock x:Name="StateText" Text="{Binding Status}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
            </DockPanel>
          </Border>
          <DockPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,5,0,0">
            <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressLabel}" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="8,0,0,0"/>
            <ProgressBar x:Name="FileProgress" Height="4" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}"
                         IsIndeterminate="{Binding IsIndeterminate}" Foreground="{StaticResource AccentBrush}" Background="{StaticResource LineBrush}"
                         BorderThickness="0" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}"/>
          </DockPanel>
          <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Details}" Style="{StaticResource ConverterMessage}" Margin="0,4,0,0"/>
        </Grid>
        <DataTemplate.Triggers>
          <DataTrigger Binding="{Binding State}" Value="Running">
            <Setter TargetName="StateBadge" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
            <Setter TargetName="StateGlyph" Property="Text" Value="&#xE895;"/>
            <Setter TargetName="StateGlyph" Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource AccentPressedBrush}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding State}" Value="Saved">
            <Setter TargetName="StateBadge" Property="Background" Value="{StaticResource SuccessSoftBrush}"/>
            <Setter TargetName="StateGlyph" Property="Text" Value="&#xE73E;"/>
            <Setter TargetName="StateGlyph" Property="Foreground" Value="{StaticResource SuccessBrush}"/>
            <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource SuccessBrush}"/>
            <Setter TargetName="FileProgress" Property="Foreground" Value="{StaticResource SuccessBrush}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding State}" Value="Failed">
            <Setter TargetName="StateBadge" Property="Background" Value="{StaticResource WarningSoftBrush}"/>
            <Setter TargetName="StateGlyph" Property="Text" Value="&#xE7BA;"/>
            <Setter TargetName="StateGlyph" Property="Foreground" Value="{StaticResource WarningBrush}"/>
            <Setter TargetName="StateText" Property="Foreground" Value="{StaticResource WarningBrush}"/>
            <Setter TargetName="FileProgress" Property="Foreground" Value="{StaticResource WarningBrush}"/>
          </DataTrigger>
          <DataTrigger Binding="{Binding State}" Value="Canceled"><Setter TargetName="StateGlyph" Property="Text" Value="&#xE711;"/><Setter TargetName="FileProgress" Property="Foreground" Value="{StaticResource MutedBrush}"/></DataTrigger>
          <DataTrigger Binding="{Binding State}" Value="Skipped"><Setter TargetName="StateGlyph" Property="Text" Value="&#xE8AD;"/></DataTrigger>
        </DataTemplate.Triggers>
      </DataTemplate></Setter.Value></Setter>
    </Style>
    <DataTemplate x:Key="RouterImportForm">
      <Grid Margin="20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
          <TextBlock Text="Appareils connectés à la box" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/>
