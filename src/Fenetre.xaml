                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="CatalogTitle" Text="Catalogue d’outils" FontSize="35" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="Diagnostiquez votre PC, testez votre réseau et convertissez vos fichiers."
                             Margin="1,4,0,0" Foreground="#DEE6FF" FontSize="14" TextWrapping="Wrap"/>
                  <Grid Margin="0,17,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="465"/></Grid.ColumnDefinitions>
                    <Border x:Name="CatalogSearchFrame" CornerRadius="7">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="2"/>
                          <Setter Property="BorderBrush" Value="White"/>
                          <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#8FAAFF"/></Trigger></Style.Triggers>
                        </Style>
                      </Border.Style>
                      <Grid MinHeight="36">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" Foreground="#556789" FontSize="15" HorizontalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="CatalogSearch" Grid.Column="1" FontSize="14" Foreground="#1A2438" CaretBrush="#3656D4"
                                 Background="Transparent" Padding="0" BorderThickness="0" VerticalContentAlignment="Center" FocusVisualStyle="{x:Null}"
                                 AutomationProperties.Name="Rechercher un outil" AutomationProperties.AcceleratorKey="Ctrl+K">
                          <TextBox.Template><ControlTemplate TargetType="TextBox">
                            <Border Background="Transparent"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False"/></Border>
                          </ControlTemplate></TextBox.Template>
                        </TextBox>
                        <TextBlock Grid.Column="1" Text="Rechercher un outil ou un format…" VerticalAlignment="Center" FontSize="14"
                                   Foreground="#586780" TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
                          <TextBlock.Style><Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=CatalogSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                          </Style></TextBlock.Style>
                        </TextBlock>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="5,1" Margin="5,0,7,0" CornerRadius="3" IsHitTestVisible="False"
                                Background="#F4F6FB" BorderBrush="#DCE2EF" BorderThickness="1">
                          <Border.Style><Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=CatalogSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                          </Style></Border.Style>
                          <TextBlock Text="Ctrl+K" FontSize="11" Foreground="#526078"/>
                        </Border>
                        <Button x:Name="CatalogClear" Grid.Column="2" Style="{StaticResource Action}" Padding="7,4" Margin="2,1,2,1"
                                Visibility="Collapsed" ToolTip="Effacer la recherche" AutomationProperties.Name="Effacer la recherche">
                          <TextBlock Text="&#xE711;" Style="{StaticResource Glyph}" FontSize="12"/>
                        </Button>
                      </Grid>
                    </Border>
                  </Grid>
                </StackPanel>
                <Viewbox x:Name="CatalogArt" Grid.Column="1" Width="234" MaxHeight="136" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Focusable="False">
                  <Canvas Width="266" Height="154" ClipToBounds="True">
                    <Rectangle Width="266" Height="154">
                      <Rectangle.Fill><RadialGradientBrush Center=".59,.55" RadiusX=".49" RadiusY=".55">
                        <GradientStop Color="#A34E79F5" Offset="0"/><GradientStop Color="#004E79F5" Offset="1"/>
                      </RadialGradientBrush></Rectangle.Fill>
                    </Rectangle>
                    <Rectangle Canvas.Left="1" Canvas.Top="1" Width="264" Height="151" Opacity=".38">
                      <Rectangle.Fill><DrawingBrush TileMode="Tile" Viewport="0,0,11,11" ViewportUnits="Absolute" Viewbox="0,0,11,11" ViewboxUnits="Absolute">
                        <DrawingBrush.Drawing><GeometryDrawing Brush="#94A9E7"><GeometryDrawing.Geometry><EllipseGeometry Center="2,2" RadiusX=".7" RadiusY=".7"/></GeometryDrawing.Geometry></GeometryDrawing></DrawingBrush.Drawing>
                      </DrawingBrush></Rectangle.Fill>
                    </Rectangle>
                    <Path Data="M13,100 H42 L51,92 M202,32 L217,19 H251 M190,133 H219 L230,122 H253" Stroke="#6585CF" StrokeThickness="1"/>
                    <Ellipse Canvas.Left="10" Canvas.Top="98" Width="4" Height="4" Fill="#A3BDFB"/>
                    <Ellipse Canvas.Left="250" Canvas.Top="17" Width="4" Height="4" Fill="#A3BDFB"/>
                    <Ellipse Canvas.Left="251" Canvas.Top="120" Width="4" Height="4" Fill="#A3BDFB"/>
                    <Canvas>
                      <Canvas.RenderTransform><MatrixTransform Matrix="1,-0.20,0.15,0.95,44,58"/></Canvas.RenderTransform>
                      <Rectangle Canvas.Left="24" Canvas.Top="-16" Width="146" Height="88" RadiusX="5" RadiusY="5" Fill="#344E92" Stroke="#788ECD" StrokeThickness="1"/>
                      <Rectangle Canvas.Left="12" Canvas.Top="-8" Width="146" Height="88" RadiusX="5" RadiusY="5" Fill="#344E93" Stroke="#9BAFE7" StrokeThickness="1.1"/>
                      <Rectangle Width="146" Height="88" RadiusX="5" RadiusY="5" Stroke="#BCD1FF" StrokeThickness="1.5">
                        <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                          <GradientStop Color="#547ADD" Offset="0"/><GradientStop Color="#3758AB" Offset=".6"/><GradientStop Color="#2C458A" Offset="1"/>
                        </LinearGradientBrush></Rectangle.Fill>
                      </Rectangle>
                      <Path Data="M1,15 H145" Stroke="#A2BDFB" StrokeThickness="1"/>
                      <Ellipse Canvas.Left="7" Canvas.Top="6" Width="3" Height="3" Fill="#DAE8FF"/>
                      <Ellipse Canvas.Left="14" Canvas.Top="6" Width="3" Height="3" Fill="#B2C9FF"/>
                      <Ellipse Canvas.Left="21" Canvas.Top="6" Width="3" Height="3" Fill="#92B1F7"/>
                      <Path Data="M9,33 H137 M9,49 H137 M9,65 H137 M29,22 V76 M51,22 V76 M73,22 V76 M95,22 V76 M117,22 V76"
                            Stroke="#6485D1" StrokeThickness=".65"/>
                      <Path Data="M9,60 L32,60 40,54 53,55 65,31 76,66 87,45 102,48 114,37 135,37" Stroke="#CDEBFF" StrokeThickness="2.5"
                            StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                      <Ellipse Canvas.Left="132.5" Canvas.Top="34.5" Width="5" Height="5" Fill="#EAF8FF"/>
                      <Path Data="M10,79 H25 M29,79 H40" Stroke="#94B5FF" StrokeThickness="1.5"/>
                    </Canvas>
                  </Canvas>
                </Viewbox>
              </Grid>
            </Border>
            <Grid Margin="0,19,0,9">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <WrapPanel x:Name="CatalogFilters" VerticalAlignment="Center" AutomationProperties.Name="Filtrer par famille">
                <RadioButton x:Name="CatalogAll" Content="Tous" Tag="" IsChecked="True" Style="{StaticResource CatalogFilter}"/>
                <RadioButton x:Name="CatalogHardware" Content="Matériel" Tag="Matériel" Style="{StaticResource CatalogFilter}"/>
                <RadioButton x:Name="CatalogNetwork" Content="Réseau" Tag="Réseau" Style="{StaticResource CatalogFilter}"/>
                <RadioButton x:Name="CatalogSystem" Content="Système" Tag="Système" Style="{StaticResource CatalogFilter}"/>
                <RadioButton x:Name="CatalogFiles" Content="Fichiers" Tag="Fichiers" Style="{StaticResource CatalogFilter}"/>
              </WrapPanel>
              <TextBlock x:Name="CatalogCount" Grid.Column="1" Margin="0,1,0,5" VerticalAlignment="Center" HorizontalAlignment="Right"
                         FontSize="13" Foreground="{DynamicResource MutedBrush}"/>
            </Grid>
            <StackPanel x:Name="CatalogItems">
              <UniformGrid x:Name="CatalogGrid" Columns="3" Margin="-5,0,-5,0"/>
            </StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Visibility="{Binding Visibility, ElementName=CatalogEmpty}">
              <StackPanel HorizontalAlignment="Center" Margin="6,12">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="22" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
                <TextBlock x:Name="CatalogEmpty" Text="Aucun outil trouvé" FontSize="19" FontWeight="SemiBold" Margin="0,9,0,3"
                           TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"/>
                <TextBlock Text="Essayez un autre mot ou affichez tous les outils." Foreground="{DynamicResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap"/>
                <Button x:Name="CatalogReset" Content="Afficher tous les outils" Style="{StaticResource Action}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel x:Name="HelpPage" Visibility="Collapsed"/>
          <StackPanel x:Name="SettingsView" Visibility="Collapsed">
            <TextBlock x:Name="SettingsNotice" Visibility="Collapsed" TextWrapping="Wrap"
                       Foreground="{DynamicResource WarningBrush}" Margin="0,0,0,12"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <Border x:Name="DuplicateSelectionBar" Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{StaticResource LineBrush}" Background="{StaticResource SurfaceBrush}" Padding="14,8">
        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/>
          <Style.Triggers><DataTrigger Binding="{Binding IsVisible, ElementName=DuplicateCompare}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
        </Style></Border.Style>
        <DockPanel MaxWidth="1280">
          <Button x:Name="DuplicateReview" DockPanel.Dock="Right" Content="Vérifier ma sélection" Style="{StaticResource PrimaryAction}" Margin="8,0,0,0"/>
          <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="DuplicateSelectionCategory" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock x:Name="DuplicateSelection" TextWrapping="Wrap" FontWeight="SemiBold"/>
          </StackPanel>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
