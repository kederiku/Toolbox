                            <Border x:Name="RowFrame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                                    CornerRadius="7" Margin="1" Padding="1,4,6,4">
                              <DockPanel>
                                <ToggleButton x:Name="BranchToggle" Width="22" MinHeight="28" Focusable="False" ClickMode="Press"
                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                  AutomationProperties.Name="Développer ou réduire la branche">
                                  <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent"><Path x:Name="Chevron" Width="5" Height="8" Stretch="Fill"
