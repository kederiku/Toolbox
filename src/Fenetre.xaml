                              <Setter TargetName="RowFrame" Property="BorderBrush" Value="{StaticResource AccentLineBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RowFrame" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate></Setter.Value></Setter>
                      </Style>
                    </TreeView.Resources>
                  </TreeView>
