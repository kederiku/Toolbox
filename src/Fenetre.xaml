                            <Border x:Name="StateFrame" Grid.Column="1" VerticalAlignment="Center" CornerRadius="5" Padding="7,3" Background="{StaticResource SuccessSoftBrush}">
                              <TextBlock x:Name="StateLabel" Text="{Binding Status}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                            </Border>
                          </Grid></Expander.Header>
                          <StackPanel>
                            <TextBlock x:Name="FindingAdvice" Text="{Binding Advice}" TextWrapping="Wrap" Margin="0,0,0,5"/>
                            <TextBlock Text="{Binding Threshold}" Foreground="{StaticResource MutedBrush}" FontSize="13" TextWrapping="Wrap"/>
                          </StackPanel>
                        </Expander>
                      </Border>
                      <DataTemplate.Triggers>
