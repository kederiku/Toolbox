        <Expander x:Name="PasteBox" Grid.Row="1" Header="Utiliser une liste copiée" Margin="0,10,0,0">
          <StackPanel Margin="0,5,0,0">
            <Label Target="{Binding ElementName=BoxText}" Content="Collez les appareils avec les en-têtes de colonnes si possible." Padding="0,0,0,4"/>
            <TextBox x:Name="BoxText" AutomationProperties.Name="Liste copiée depuis la box" AcceptsReturn="True" AcceptsTab="False"
