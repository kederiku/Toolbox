                          <Setter TargetName="StateFrame" Property="Background" Value="{StaticResource WarningSoftBrush}"/>
                          <Setter TargetName="StateLabel" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Unavailable">
                          <Setter TargetName="FindingValue" Property="Visibility" Value="Collapsed"/>
                          <Setter TargetName="StateFrame" Property="Background" Value="{StaticResource CanvasBrush}"/>
                          <Setter TargetName="StateLabel" Property="Foreground" Value="{StaticResource MutedBrush}"/>
